import ROOT
import os
import glob
import awkward as ak
import numpy as np

def main():
    #############################################
    ############ 1. GETTING THE FILES ###########
    #############################################
    path_to_cuda = "/eos/experiment/ship/simulation/cuda_muons/try_2025/processed_muons/1/sim_df0072b9-69ff-4a95-ac90-e443f74f6981.root"

    f_in = ROOT.TFile.Open(path_to_cuda, "READ") 
    tree_in = f_in.Get("cbmsim")

    f_out = ROOT.TFile.Open("cuda_muons/filtered_muons.root", "RECREATE")
    tree_out = tree_in.CloneTree(0) 

    #############################################
    ############ 2. FILTERING THE DATA ##########
    #############################################

    n_entries = tree_in.GetEntries()
    events_kept = 0
    # Loop over all events
    for i in range(n_entries):
        tree_in.GetEntry(i)
        
        has_primary_sst_hit = False
        
        # Loop over the strawtubes hits in this specific event
        for hit in tree_in.strawtubesPoint:
            if hit.GetTrackID() == 0:  # Check if it belongs to the primary muon
                has_primary_sst_hit = True
                break # We only need one valid hit to keep the event
                
        # If the event has a primary SST hit, fill it into the new cloned tree
        if has_primary_sst_hit:
            tree_out.Fill()
            events_kept += 1
            
    print(f"Events kept (primary muon reached SST): {events_kept}")

    #############################################
    ############ 3. STORING THE DATA ############
    #############################################
    tree_out.Write()
    f_out.Close()
    f_in.Close()

if __name__ == "__main__":
    main()